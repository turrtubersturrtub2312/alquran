{
  "title": "Quran Mulism",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\r\n<html lang=\"ms\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <link rel=\"icon\" type=\"image/png\" href=\"islam.png\">\r\n    <title>Sistem Error - Muhammad Arifin (Apin)</title>\r\n    <style>\r\n        /* ==========================================================================\r\n           CSS GABUNGAN (KESAN AMARAN ERROR & LATAR BELAKANG POLIS BERGERAK)\r\n           ========================================================================== */\r\n        * {\r\n            box-sizing: border-box;\r\n            margin: 0;\r\n            padding: 0;\r\n            font-family: 'Segoe UI', Roboto, sans-serif;\r\n        }\r\n\r\n        body {\r\n            /* Animasi latar belakang merah biru bergerak slow seperti lampu polis */\r\n            background: linear-gradient(120deg, #050000, #00000c, #050000);\r\n            background-size: 400% 400%;\r\n            animation: policeLight 6s ease infinite;\r\n            color: #fff;\r\n            min-height: 100vh;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            padding: 20px;\r\n            overflow-x: hidden;\r\n        }\r\n\r\n        /* Animasi Lampu Polis Slow */\r\n        @keyframes policeLight {\r\n            0% { background-position: 0% 50%; background-color: rgba(150, 0, 0, 0.2); }\r\n            50% { background-position: 100% 50%; background-color: rgba(0, 0, 150, 0.2); }\r\n            100% { background-position: 0% 50%; background-color: rgba(150, 0, 0, 0.2); }\r\n        }\r\n\r\n        .error-container {\r\n            max-width: 800px;\r\n            width: 100%;\r\n            background: rgba(0, 0, 0, 0.85);\r\n            backdrop-filter: blur(15px);\r\n            -webkit-backdrop-filter: blur(15px);\r\n            padding: 40px;\r\n            border-radius: 20px;\r\n            text-align: center;\r\n            box-shadow: 0 0 30px rgba(255, 0, 0, 0.3);\r\n            border: 2px solid rgba(255, 0, 0, 0.5);\r\n        }\r\n\r\n        /* Tulisan Merah Bercahaya (Glow Efek) */\r\n        .error-title {\r\n            color: #ff0000;\r\n            font-size: 2.5rem;\r\n            font-weight: bold;\r\n            text-transform: uppercase;\r\n            margin-bottom: 25px;\r\n            text-shadow: 0 0 10px #ff0000, 0 0 20px #ff0000, 0 0 40px #ff0000;\r\n            animation: blink 1.5s infinite alternate;\r\n        }\r\n\r\n        @keyframes blink {\r\n            0% { opacity: 0.8; text-shadow: 0 0 10px #ff0000; }\r\n            100% { opacity: 1; text-shadow: 0 0 20px #ff0000, 0 0 40px #ff3333; }\r\n        }\r\n\r\n        .error-message {\r\n            font-size: 1.2rem;\r\n            line-height: 1.8;\r\n            color: #e0e0e0;\r\n            margin-bottom: 30px;\r\n            padding: 20px;\r\n            background: rgba(255, 0, 0, 0.05);\r\n            border-left: 4px solid #ff0000;\r\n            border-radius: 4px;\r\n            text-align: justify;\r\n        }\r\n\r\n        /* Butang Reset */\r\n        .btn-reset {\r\n            background: linear-gradient(135deg, #ff0000, #b30000);\r\n            color: white;\r\n            border: none;\r\n            padding: 12px 30px;\r\n            font-size: 1rem;\r\n            font-weight: bold;\r\n            border-radius: 25px;\r\n            cursor: pointer;\r\n            transition: 0.3s;\r\n            box-shadow: 0 4px 15px rgba(255, 0, 0, 0.4);\r\n            margin-bottom: 40px;\r\n        }\r\n\r\n        .btn-reset:hover {\r\n            transform: scale(1.05);\r\n            box-shadow: 0 0 20px #ff0000;\r\n        }\r\n\r\n        /* Bahagian Ruang Komen */\r\n        .comment-section {\r\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\r\n            padding-top: 30px;\r\n            text-align: left;\r\n        }\r\n\r\n        .comment-section h3 {\r\n            color: #3399ff;\r\n            margin-bottom: 15px;\r\n            font-size: 1.3rem;\r\n        }\r\n\r\n        .comment-form textarea {\r\n            width: 100%;\r\n            height: 100px;\r\n            background: rgba(255, 255, 255, 0.07);\r\n            border: 1px solid rgba(255, 255, 255, 0.2);\r\n            border-radius: 10px;\r\n            padding: 12px;\r\n            color: white;\r\n            font-size: 0.95rem;\r\n            outline: none;\r\n            resize: none;\r\n            transition: 0.3s;\r\n        }\r\n\r\n        .comment-form textarea:focus {\r\n            border-color: #3399ff;\r\n            background: rgba(255, 255, 255, 0.12);\r\n        }\r\n\r\n        .btn-comment {\r\n            background: #3399ff;\r\n            color: white;\r\n            border: none;\r\n            padding: 10px 20px;\r\n            border-radius: 5px;\r\n            font-weight: bold;\r\n            cursor: pointer;\r\n            margin-top: 10px;\r\n            transition: 0.3s;\r\n        }\r\n\r\n        .btn-comment:hover {\r\n            background: #0077e6;\r\n        }\r\n\r\n        .comments-list {\r\n            margin-top: 25px;\r\n            max-height: 300px;\r\n            overflow-y: auto;\r\n        }\r\n\r\n        .comment-box {\r\n            background: rgba(255, 255, 255, 0.05);\r\n            padding: 15px;\r\n            border-radius: 8px;\r\n            margin-bottom: 15px;\r\n            border-left: 3px solid #3399ff;\r\n        }\r\n\r\n        .user-comment {\r\n            font-size: 0.95rem;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .reply-box {\r\n            background: rgba(51, 153, 255, 0.1);\r\n            padding: 10px;\r\n            border-radius: 5px;\r\n            margin-top: 8px;\r\n            font-size: 0.9rem;\r\n            border-left: 2px solid #3399ff;\r\n        }\r\n\r\n        .reply-author {\r\n            color: #ffd700;\r\n            font-weight: bold;\r\n            margin-bottom: 2px;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <div class=\"error-container\">\r\n        <div class=\"error-title\">⚠️ SYSTEM ERROR</div>\r\n        \r\n        <div class=\"error-message\">\r\n            Maaf kami sedang beroperasi kerana ada Sistem Error sila mencuba lagi atau reset website ini! Dari Tuan Muhammad Arifin (Apin) kemungkinan akan selesai Error sistem ini berkemungkinan jatuh pada hari jumaat atau 3 hari Sila dukung kami!\r\n        </div>\r\n\r\n\r\n        <div class=\"comment-section\">\r\n            <h3>Ruang Pertanyaan & Komen</h3>\r\n            <div class=\"comment-form\">\r\n                <textarea id=\"comment-input\" placeholder=\"Tulis apa-apa atau tanya soalan di sini...\"></textarea>\r\n                <button class=\"btn-comment\" onclick=\"addComment()\">Hantar Komen</button>\r\n            </div>\r\n\r\n            <div class=\"comments-list\" id=\"comments-list\">\r\n                <div class=\"comment-box\">\r\n                    <p class=\"user-comment\"><strong>Hamba Allah:</strong> Assalamualaikum Tuan Apin, kenapa sistem error ya? Semoga cepat selesai urusan kemas kini web ini.</p>\r\n                    <div class=\"reply-box\">\r\n                        <p class=\"reply-author\">Tuan Muhammad Arifin (Apin):</p>\r\n                        <p>Waalaikumussalam, terima kasih atas sokongan! Sistem sedang dinaik taraf untuk menambah fungsi yang lebih besar. Insya-Allah akan siap dalam masa terdekat.</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        // Fungsi Butang Reset Website\r\n        function resetWebsite() {\r\n            alert(\"Sedang memulakan semula sambungan ke pelayan...\");\r\n            window.location.reload();\r\n        }\r\n\r\n        // Fungsi Menambah Komen Baharu\r\n        function addComment() {\r\n            const commentInput = document.getElementById('comment-input');\r\n            const commentText = commentInput.value.trim();\r\n            const commentsList = document.getElementById('comments-list');\r\n\r\n            if (commentText === \"\") {\r\n                alert(\"Sila tulis sesuatu sebelum menghantar komen.\");\r\n                return;\r\n            }\r\n\r\n            // Cipta elemen kotak komen baru\r\n            const commentBox = document.createElement('div');\r\n            commentBox.className = 'comment-box';\r\n\r\n            // Masukkan teks komen pengguna dan sediakan balasan automatik daripada Tuan Apin\r\n            commentBox.innerHTML = `\r\n                <p class=\"user-comment\"><strong>Pengguna Web:</strong> ${commentText}</p>\r\n                <div class=\"reply-box\">\r\n                    <p class=\"reply-author\">Tuan Muhammad Arifin (Apin):</p>\r\n                    <p>Terima kasih kerana bertanya. Soalan anda telah diterima! Saya akan meneliti perkara ini secepat mungkin bagi memulihkan sistem.</p>\r\n                </div>\r\n            `;\r\n\r\n            // Letakkan komen baharu di bahagian atas senarai\r\n            commentsList.insertBefore(commentBox, commentsList.firstChild);\r\n\r\n            // Bersihkan ruangan input teks selepas hantar\r\n            commentInput.value = \"\";\r\n        }\r\n    </script>\r\n</body>\r\n</html>"
  },
